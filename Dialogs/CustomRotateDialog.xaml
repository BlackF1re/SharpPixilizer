<Window x:Class="SharpPixilizer.CustomRotateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Другой угол вращения" Height="150" Width="300">
    <StackPanel Margin="10">
        <Label Content="Введите угол вращения:"/>
        <TextBox x:Name="AngleTextBox" Margin="5"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="60" Click="OKButton_Click" Margin="5"/>
            <Button Content="Отмена" Width="60" Click="CancelButton_Click" Margin="5"/>
        </StackPanel>
    </StackPanel>
</Window>
